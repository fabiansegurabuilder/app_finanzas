# Variables de entorno — App Finanzas Personales
# Copia este archivo a `.env.local` y completa los valores reales.
# NUNCA subas `.env.local` al repositorio.

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
