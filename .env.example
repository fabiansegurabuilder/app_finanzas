# Variables de entorno — App Finanzas Personales
# Copia este archivo a `.env.local` y completa los valores reales.
# NUNCA subas `.env.local` al repositorio.

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# URL pública del sitio (usada para metadatos Open Graph). En local puedes
# dejar el valor por defecto; en producción usa el dominio de Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nombre visible de la aplicación (aparece en el logo y el título).
NEXT_PUBLIC_APP_NAME=Finanzas

# Moneda y locale para formatear valores (opcional; por defecto Colombia).
# Ejemplos: MXN/es-MX, USD/en-US, EUR/es-ES, ARS/es-AR.
NEXT_PUBLIC_MONEDA=COP
NEXT_PUBLIC_LOCALE=es-CO
